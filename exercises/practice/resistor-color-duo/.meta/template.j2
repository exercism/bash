{{ header }}
{% for case in cases %}
{{ case.test_function_start }}
    {% if loop.first %}# {% endif %}[[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash {{ solution }} {{ case.given | join(" ") }}
{%- if case.expect_error %}
    {#- The error message from the canonical data is not used. #}
    assert_failure
    assert_output --partial "invalid color"
{%- else %}
    assert_success
    assert_output "{{ case.expected }}"
{%- endif %}
}
{% endfor %}
test_invalid_color () { #@test
    [[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash {{ solution }} foo
    assert_failure
    assert_output --partial "invalid color"
}

test_one_valid_color_and_one_invalid_color () { #@test
    [[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash {{ solution }} blue foo
    assert_failure
    assert_output --partial "invalid color"
}

test_one_invalid_color_and_one_valid_color () { #@test
    [[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash {{ solution }} foo blue
    assert_failure
    assert_output --partial "invalid color"
}

