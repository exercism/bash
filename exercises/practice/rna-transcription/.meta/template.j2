{{ header }}
{% for case in cases %}
{{ case.test_function_start }}
    {% if loop.first %}# {% endif %}[[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash {{ solution }} "{{ case.given }}"
    assert_success
    assert_output "{{ case.expected }}"
}
{% endfor %}
test_handles_invalid_character () { #@test
    [[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash {{ solution }} ACGTXCTTA
    assert_failure
    assert_output "Invalid nucleotide detected."
}

test_handles_completely_invalid_string () { #@test
    [[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash {{ solution }} XXXX
    assert_failure
    assert_output "Invalid nucleotide detected."
}

test_handles_partially_invalid_string () { #@test
    [[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash {{ solution }} ACGTXCTTAA
    assert_failure
    assert_output "Invalid nucleotide detected."
}
