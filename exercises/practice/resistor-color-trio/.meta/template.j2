{{ header }}
{% for case in cases %}
{{ case.test_function_start }}
    {% if loop.first %}# {% endif %}[[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash {{ solution }} "{{ case.given | join('" "') }}"
    assert_success
    assert_output "{{ case.expected.value }} {{ case.expected.unit }}"
}
{% endfor %}

test_invalid_first_color () { #@test
    [[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash {{ solution }} "foo" "white" "white"
    assert_failure
    assert_output    # there is _some_ output
}

