{{ header }}
{% for case in cases %}
{{ case.test_function_start }}
    {% if loop.first %}# {% endif %}[[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash {{ solution }} "{{ case.given }}"
{%- if case.expect_error %}
    assert_failure
    assert_output "{{ case.expect_error_msg }}"
{%- else %}
    assert_success
    assert_output "{{ case.expected | join(" ") }}"
{%- endif %}
}
{% endfor %}
