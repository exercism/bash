{{ header }}
join() {
    local IFS=$'\n'
    echo "$*"
}
{% for case in cases %}
{{ case.test_function_start }}
    {% if loop.first %}# {% endif %}[[ $BATS_RUN_SKIPPED == "true" ]] || skip
    input=(
{%- for row in case.given %}
        "{{ row | join("") }}"
{%- endfor %}
    )
    expected_rows=(
{%- for row in case.expected %}
        "{{ row | join("") }}"
{%- endfor %}
    )
    expected_string="$(join "${expected_rows[@]}")"
    run bash {{ solution }} "${input[@]}"
    assert_success
    assert_output "$expected_string"
}
{% endfor %}
