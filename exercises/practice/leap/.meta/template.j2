test_no_input_should_return_an_error() { # @test
    [[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash {{ solution }}

    assert_failure
    assert_output "Usage: {{ solution }} <year>"
}

test_too_many_arguments_should_return_an_error() { # @test
    [[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash {{ solution }} 2016 4562 4566

    assert_failure
    assert_output "Usage: {{ solution }} <year>"
}

