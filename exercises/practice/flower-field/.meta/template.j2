{{ header }}

join() {
    local IFS=$'\n'
    echo "$*"
}
{% for case in cases %}
{{ case.test_function_start }}
    {% if loop.first %}# {% endif %}[[ $BATS_RUN_SKIPPED == "true" ]] || skip
    input=({% for line in case.given %}
        "{{ line }}"
        {%- endfor %}
    )
    run bash {{ solution }} "${input[@]}"
    assert_success
    expected=({% for line in case.expected %}
        "{{ line }}"
        {%- endfor %}
    )
    assert_output "$(join "${expected[@]}")"
}
{% endfor %}
