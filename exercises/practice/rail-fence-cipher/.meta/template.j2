{{ header }}
{% for case in cases %}
{{ case.test_function_start }}
    {% if loop.first %}# {% endif %}[[ $BATS_RUN_SKIPPED == "true" ]] || skip
{%- if case.property == "encode" %}
    run bash {{ solution }} -e {{ case.input.rails }} "{{ case.input.msg }}"
{%- else %}
    run bash {{ solution }} -d {{ case.input.rails }} "{{ case.input.msg }}"
{%- endif %}
    assert_success
    assert_output "{{ case.expected }}"
}
{% endfor %}
# Track specific tests

test_encode_with_more_rails_than_text () { #@test
    [[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash rail_fence_cipher.sh -e 10 "hello"
    assert_success
    assert_output "hello"
}

test_decode_with_more_rails_than_text () { #@test
    [[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run bash rail_fence_cipher.sh -d 10 "hello"
    assert_success
    assert_output "hello"
}

test_decode_the_encoded_text_yields_the_original () { #@test
    [[ $BATS_RUN_SKIPPED == "true" ]] || skip
    plaintext="the quick brown fox jumped over the lazy dogs"
    rails=5
    run bash rail_fence_cipher.sh -e $rails "$plaintext"
    assert_success
    ciphertext=$output
    run bash rail_fence_cipher.sh -d $rails "$ciphertext"
    assert_success
    assert_output "$plaintext"
}

