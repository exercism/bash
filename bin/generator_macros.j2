{%- macro skip_line(loop) -%}
  {%- if loop.first -%}
    # [[ $BATS_RUN_SKIPPED == "true" ]] || skip
  {%- else -%}
    [[ $BATS_RUN_SKIPPED == "true" ]] || skip
  {%- endif -%}
{%- endmacro -%}


{%- macro test_equal(case, solution, command, params, loop) -%}
{{ case.test_function_start }}
    {{ skip_line(loop) }}
    run bash {{ solution }}{% if command %} {{ command }}{% endif %}{% for param in params %} {{ case.input[param] | quote}}{% endfor %}
{%- if case.expect_error %}
    assert_failure
    assert_output {{ case.expect_error_msg | quote }}
{%- elif case.expected == "" or case.expected == None or case.expected == [] %}
    assert_success
    refute_output
{%- else %}
    assert_success
    assert_output {{ case.expected | quote }}
{%- endif %}
}
{%- endmacro -%}
